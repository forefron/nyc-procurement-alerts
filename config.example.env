# ---- Telegram (required) ---------------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> copy the token
TELEGRAM_BOT_TOKEN=123456789:AAExample-Token-From-BotFather

# 2. Add the bot to your group (or make it admin of your channel),
#    then get the chat id (message @userinfobot in the group, or use
#    https://api.telegram.org/bot<TOKEN>/getUpdates after posting once)
TELEGRAM_CHAT_ID=-1001234567890

# ---- Data feed tuning --------------------------------------------------
# Optional free Socrata app token (higher rate limits):
# https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
# Which City Record notice types to alert on:
NOTICE_TYPES=Solicitation
# How many days back to index on first run:
FIRST_RUN_LOOKBACK_DAYS=2
